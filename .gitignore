# DialectDuel - .gitignore
# Environment variables (keep API key secret!)
.env
firebase-debug.log
firebase-debug.*.log
.firebase/

# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/release/
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/{project.xcworkspace,xcuserdata}
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/*.d
**/ios/**/Icon?
**/ios/**/*.lock
**/ios/**/*.log
**/ios/**/*.moved-aside
**/ios/**/*.orig
**/ios/**/xcuserdata/
**/ios/**/.DS_Store
**/ios/**/.dep_submap
**/ios/**/.symtab
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3

# macOS
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Exceptions
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
.aider*
